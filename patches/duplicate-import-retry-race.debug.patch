+
+import type { CoreSetup } from '@kbn/core-lifecycle-server';
+import type { Logger } from '@kbn/core/server';
+
+const IMPORT_PATH_MATCH = '/api/detection_engine/rules/_import';
+
+// Logs every ingress at the child Kibana for the rule import endpoint so we can
+// tell whether a duplicate POST (same traceparent, new request id) is coming
+// from an upstream re-dispatch (dev base-path proxy, LB, browser) or from hapi
+// replaying its own handler. Enable with KBN_DEBUG_IMPORT_RETRY=1.
+export function registerImportRetryDebug(core: CoreSetup, logger: Logger) {
+  if (process.env.KBN_DEBUG_IMPORT_RETRY !== '1') return;
+
+  const log = logger.get('importRetryDebug');
+  log.warn('KBN_DEBUG_IMPORT_RETRY=1 — ingress probe active on ' + IMPORT_PATH_MATCH);
+
+  core.http.registerOnPreAuth((request, response, toolkit) => {
+    const url = request.url.pathname ?? '';
+    if (!url.includes(IMPORT_PATH_MATCH)) {
+      return toolkit.next();
+    }
+
+    const headers = request.headers as Record<string, string | string[] | undefined>;
+    const pick = (name: string) => {
+      const value = headers[name];
+      return Array.isArray(value) ? value.join(',') : value;
+    };
+
+    log.warn(
+      `child ingress method=${request.route.method.toUpperCase()} url=${url} ` +
+        `reqId=${request.id} traceparent=${pick('traceparent') ?? '-'} ` +
+        `xopaqueId=${pick('x-opaque-id') ?? '-'} ` +
+        `xff=${pick('x-forwarded-for') ?? '-'} ` +
+        `xfport=${pick('x-forwarded-port') ?? '-'} ` +
+        `contentLength=${pick('content-length') ?? '-'} ` +
+        `ua=${(pick('user-agent') ?? '-').slice(0, 60)} ` +
+        `ts=${new Date().toISOString()}`
+    );
+
+    request.events.completed$.subscribe(() => {
+      log.warn(`child completed  reqId=${request.id} ts=${new Date().toISOString()}`);
+    });
+    request.events.aborted$.subscribe(() => {
+      log.warn(`child aborted    reqId=${request.id} ts=${new Date().toISOString()}`);
+    });
+
+    return toolkit.next();
+  });
+}
